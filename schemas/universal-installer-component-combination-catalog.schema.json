{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/autonomous-engineering-system/forge-platform/schemas/universal-installer-component-combination-catalog.schema.json",
  "title": "Forge Platform universal installer component-combination catalog",
  "description": "Immutable, digest-pinned selection index. It is consumed only when the verified outer composition catalog's component_combination_catalog locator binds these exact bytes; this payload does not create a second installer release or trust root.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "channel", "published_at", "expires_at", "compositions"],
  "properties": {
    "schema": {"const": "forge-platform.component-combination-catalog/v1"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "channel": {"enum": ["stable", "candidate"]},
    "published_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "compositions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/composition"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "composition_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uD800-\\uDFFF]+$",
      "description": "Bounded Unicode composition identity without Unicode White_Space or C0/DEL controls; runtime validation mirrors the signed outer catalog and native session grammar."
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://(?:[A-Za-z0-9._-]+(?::443)?|\\[[0-9A-Fa-f:.]+\\](?::443)?)(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?$",
      "description": "ASCII canonical HTTPS URL: no user info or fragment, and port omitted or exactly 443. Runtime parsers also reject malformed percent escapes and non-canonical serialization."
    },
    "version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
    "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{0,127}$"},
    "installer_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version", "capabilities"],
      "properties": {
        "minimum_version": {"$ref": "#/$defs/version"},
        "capabilities": {
          "type": "array",
          "items": {"$ref": "#/$defs/capability"},
          "uniqueItems": true
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "requires_capabilities"],
      "properties": {
        "identity": {"$ref": "#/$defs/capability"},
        "requires_capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/capability"},
          "uniqueItems": true
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "digest"],
      "properties": {
        "url": {"$ref": "#/$defs/https_url"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition_id", "selection_sequence", "channel", "manifest", "components", "requires_installer", "upgrade_from"],
      "properties": {
        "composition_id": {"$ref": "#/$defs/composition_identity"},
        "selection_sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "channel": {"enum": ["stable", "candidate"]},
        "manifest": {"$ref": "#/$defs/manifest"},
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/component"}
        },
        "requires_installer": {"$ref": "#/$defs/installer_requirement"},
        "upgrade_from": {
          "type": "array",
          "items": {"$ref": "#/$defs/composition_identity"},
          "uniqueItems": true
        }
      }
    }
  }
}
