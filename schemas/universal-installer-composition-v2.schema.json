{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/autonomous-engineering-system/forge-platform/schemas/universal-installer-composition-v2.schema.json",
  "title": "Forge Platform universal installer composition v2",
  "description": "Target-aware immutable composition for managed deployments; provider requirements are bound to exact owning component-instance contexts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "composition_id",
    "channel",
    "requires_installer",
    "host_requirements",
    "managed_tools",
    "python_runtime",
    "product_venvs",
    "providers",
    "components",
    "upgrade_from"
  ],
  "properties": {
    "schema": {
      "const": "forge-platform.composition/v2"
    },
    "composition_id": {
      "$ref": "#/$defs/composition_identity"
    },
    "channel": {
      "enum": [
        "stable",
        "candidate"
      ]
    },
    "requires_installer": {
      "$ref": "#/$defs/installer_requirement"
    },
    "host_requirements": {
      "$ref": "#/$defs/host_requirement"
    },
    "managed_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/managed_tool"
      }
    },
    "python_runtime": {
      "$ref": "#/$defs/managed_python_runtime"
    },
    "product_venvs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/product_venv"
      }
    },
    "providers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/provider"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "upgrade_from": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/composition_identity"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "composition_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uD800-\\uDFFF]+$",
      "description": "Bounded Unicode composition identity without Unicode White_Space or C0/DEL controls; runtime validation mirrors the signed outer catalog and native session grammar."
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://(?:[A-Za-z0-9._-]+(?::443)?|\\[[0-9A-Fa-f:.]+\\](?::443)?)(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?$",
      "description": "ASCII canonical HTTPS URL: no user info or fragment, and port omitted or exactly 443. Runtime parsers also reject malformed percent escapes and non-canonical serialization."
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "installer_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_version",
        "capabilities"
      ],
      "properties": {
        "minimum_version": {
          "$ref": "#/$defs/version"
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9./_-]{0,127}$"
          },
          "uniqueItems": true
        }
      }
    },
    "host_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_macos_version",
        "supported_architectures",
        "minimum_available_disk_bytes",
        "backup_reserve_bytes",
        "minimum_memory_bytes",
        "requires_administrator",
        "requires_network",
        "requires_trusted_clock"
      ],
      "properties": {
        "minimum_macos_version": {
          "type": "string",
          "pattern": "^(?:2[6-9]|[3-9][0-9]|[1-9][0-9]{2,})\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
          "description": "The installer platform requires macOS 26.0.0 or newer."
        },
        "supported_architectures": {
          "const": [
            "arm64"
          ]
        },
        "minimum_available_disk_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "backup_reserve_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "minimum_memory_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "requires_administrator": {
          "type": "boolean"
        },
        "requires_network": {
          "type": "boolean"
        },
        "requires_trusted_clock": {
          "type": "boolean"
        }
      }
    },
    "managed_tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "version",
        "url",
        "digest"
      ],
      "properties": {
        "identity": {
          "const": "git"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "immutable_download": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "digest"
      ],
      "properties": {
        "url": {
          "$ref": "#/$defs/https_url"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "managed_python_runtime": {
      "description": "One exact platform-approved arm64 CPython identity. identity_digest is recomputed over every other field by the runtime parser.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "implementation",
        "version",
        "operating_system",
        "architecture",
        "minimum_macos_version",
        "build_variant",
        "python_tag",
        "abi_tag",
        "platform_tag",
        "artifact_kind",
        "managed_root_identity",
        "artifact",
        "source",
        "source_provenance",
        "build_provenance",
        "policy_revision",
        "identity_digest"
      ],
      "properties": {
        "schema": {
          "const": "forge-platform.managed-python-runtime/v1"
        },
        "implementation": {
          "const": "cpython"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "operating_system": {
          "const": "macos"
        },
        "architecture": {
          "const": "arm64"
        },
        "minimum_macos_version": {
          "type": "string",
          "pattern": "^(?:2[6-9]|[3-9][0-9]|[1-9][0-9]{2,})\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$"
        },
        "build_variant": {
          "const": "standard-gil"
        },
        "python_tag": {
          "type": "string",
          "pattern": "^cp[0-9]{2,3}$"
        },
        "abi_tag": {
          "type": "string",
          "pattern": "^cp[0-9]{2,3}$"
        },
        "platform_tag": {
          "const": "macosx_26_0_arm64"
        },
        "artifact_kind": {
          "const": "forge-platform-managed-python-runtime-archive-v1"
        },
        "managed_root_identity": {
          "const": "forge-platform-managed-python-v1"
        },
        "artifact": {
          "$ref": "#/$defs/immutable_download"
        },
        "source": {
          "$ref": "#/$defs/immutable_download"
        },
        "source_provenance": {
          "$ref": "#/$defs/immutable_download"
        },
        "build_provenance": {
          "$ref": "#/$defs/immutable_download"
        },
        "policy_revision": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"
        },
        "identity_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "product_venv": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_identity",
        "venv_identity",
        "python_runtime_identity"
      ],
      "properties": {
        "component_identity": {
          "enum": [
            "forge-runtime",
            "workspace-server",
            "workspace-client",
            "engineering-platform-server",
            "engineering-platform-project-agent"
          ]
        },
        "venv_identity": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "python_runtime_identity": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "python_runtime_qualification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime_identity_digest",
        "build_evidence",
        "test_evidence"
      ],
      "properties": {
        "runtime_identity_digest": {
          "$ref": "#/$defs/sha256"
        },
        "build_evidence": {
          "$ref": "#/$defs/immutable_download"
        },
        "test_evidence": {
          "$ref": "#/$defs/immutable_download"
        }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "required",
        "minimum_version",
        "credential_scope",
        "owner_component",
        "target_identity"
      ],
      "properties": {
        "identity": {
          "enum": [
            "codex",
            "github-cli"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "minimum_version": {
          "anyOf": [
            {
              "$ref": "#/$defs/version"
            },
            {
              "type": "null"
            }
          ]
        },
        "credential_scope": {
          "enum": [
            "user",
            "component"
          ]
        },
        "owner_component": {
          "enum": [
            "forge-runtime",
            "engineering-platform-server",
            "engineering-platform-project-agent"
          ]
        },
        "target_identity": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "owner_component": {
                "const": "engineering-platform-project-agent"
              }
            }
          },
          "then": {
            "properties": {
              "credential_scope": {
                "const": "user"
              }
            }
          },
          "else": {
            "properties": {
              "credential_scope": {
                "const": "component"
              }
            }
          }
        }
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "source_revision",
        "source",
        "digest",
        "qualification"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "source_revision": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/https_url"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "qualification": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "system_service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manager",
        "domain",
        "kind",
        "product_service_reference"
      ],
      "properties": {
        "manager": {
          "const": "launchd"
        },
        "domain": {
          "const": "system"
        },
        "kind": {
          "const": "LaunchDaemon"
        },
        "product_service_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "role",
        "artifact",
        "python_runtime_qualification",
        "service"
      ],
      "properties": {
        "identity": {
          "enum": [
            "forge-runtime",
            "workspace-server",
            "workspace-client",
            "engineering-platform-server",
            "engineering-platform-project-agent"
          ]
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "$ref": "#/$defs/artifact"
        },
        "python_runtime_qualification": {
          "$ref": "#/$defs/python_runtime_qualification"
        },
        "service": {
          "anyOf": [
            {
              "$ref": "#/$defs/system_service"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "identity": {
                "enum": [
                  "forge-runtime",
                  "workspace-server",
                  "engineering-platform-server"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "service": {
                "$ref": "#/$defs/system_service"
              }
            }
          },
          "else": {
            "properties": {
              "service": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
