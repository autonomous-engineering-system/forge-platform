{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/autonomous-engineering-system/forge-platform/schemas/universal-installer-composition-catalog.schema.json",
  "title": "Forge Platform universal installer composition catalog",
  "description": "Signed, expiring index of immutable qualified Forge/EP/Workspace compositions and the one currently approved managed-Python runtime identity.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "channel", "published_at", "expires_at", "approved_python_runtime_identity", "compositions", "signatures"],
  "properties": {
    "schema": {"const": "forge-platform.composition-catalog/v1"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "channel": {"enum": ["stable", "candidate"]},
    "published_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "approved_python_runtime_identity": {
      "$ref": "#/$defs/sha256",
      "description": "The exact managed-Python identity every selectable composition must embed and every component must qualify against."
    },
    "compositions": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/composition"}
    },
    "component_combination_catalog": {
      "$ref": "#/$defs/component_combination_catalog_locator"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/public_signature_envelope"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "composition_identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F\\u0020\\u0085\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uD800-\\uDFFF]+$",
      "description": "Bounded Unicode composition identity without Unicode White_Space or C0/DEL controls; runtime validation mirrors this grammar exactly."
    },
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://(?:[A-Za-z0-9._-]+(?::443)?|\\[[0-9A-Fa-f:.]+\\](?::443)?)(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?$",
      "description": "ASCII canonical HTTPS URL: no user info or fragment, and port omitted or exactly 443. Runtime parsers also reject malformed percent escapes and non-canonical serialization."
    },
    "component_combination_catalog_locator": {
      "description": "Digest-pinned locator for the versioned component-combination selection index. The enclosing signed catalog is the trust root; the index has no independent mutable latest pointer.",
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "digest"],
      "properties": {
        "url": {"$ref": "#/$defs/https_url"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "public_signature_envelope": {
      "description": "Public Ed25519 signature envelope. Key material remains in the installer trust root; the signature is 64 raw bytes encoded as canonical unpadded base64url.",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    },
    "installer_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_version", "capabilities"],
      "properties": {
        "minimum_version": {"type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"},
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{0,127}$"},
          "uniqueItems": true
        }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["composition_id", "channel", "url", "digest", "requires_installer"],
      "properties": {
        "composition_id": {"$ref": "#/$defs/composition_identity"},
        "channel": {"enum": ["stable", "candidate"]},
        "url": {"$ref": "#/$defs/https_url"},
        "digest": {"$ref": "#/$defs/sha256"},
        "requires_installer": {"$ref": "#/$defs/installer_requirement"}
      }
    }
  }
}
