{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/autonomous-engineering-system/forge-platform/schemas/universal-installer-release.schema.json",
  "title": "Forge Platform universal installer release descriptor",
  "description": "Strict signed metadata transported as one named asset of one canonical GitHub Release. A GitHub latest marker is only a locator; the code-signed release-trust configuration verifies this descriptor before a bundle may run. Each macOS archive location is derived from github_release, never accepted as an arbitrary URL. The catalog URL remains a separately signed feed locator. Runtime admission rejects empty or over-131072-byte UTF-8 descriptor payloads before JSON or signature processing.",
  "$comment": "maxSerializedUtf8Bytes=131072; JSON Schema validates values, while the transport/parser enforces this raw-byte bound.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "sequence", "channel", "published_at", "expires_at", "github_release", "installer", "composition_catalog", "signatures"],
  "properties": {
    "schema": {"const": "forge-platform.installer-release/v1"},
    "sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "channel": {"enum": ["stable", "candidate"]},
    "published_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "expires_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "github_release": {"$ref": "#/$defs/github_release_identity"},
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "source_revision", "policy_revision", "release_trust_configuration_sha256", "provenance_sha256", "capabilities", "assets"],
      "properties": {
        "version": {"type": "string", "maxLength": 59, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "description": "Each component must also fit the native signed 64-bit InstallerVersion representation; runtime parsers enforce that numeric bound."},
        "source_revision": {"$ref": "#/$defs/source_revision"},
        "policy_revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"},
        "release_trust_configuration_sha256": {"$ref": "#/$defs/raw_sha256"},
        "provenance_sha256": {"$ref": "#/$defs/raw_sha256"},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/capability"}
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {"$ref": "#/$defs/installer_asset"}
        }
      }
    },
    "composition_catalog": {"$ref": "#/$defs/catalog_feed"},
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/public_signature_envelope"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "https_url": {
      "type": "string",
      "maxLength": 2048,
      "pattern": "^https://(?:[A-Za-z0-9._-]+(?::443)?|\\[[0-9A-Fa-f:.]+\\](?::443)?)(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?(?:\\?[A-Za-z0-9._~!$&'()*+,;=:@%/?-]*)?$",
      "description": "ASCII canonical HTTPS URL: no user info or fragment, and port omitted or exactly 443. Runtime parsers also reject malformed percent escapes and non-canonical serialization."
    },
    "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{0,127}$"},
    "github_release_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "descriptor_asset_name"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}/[A-Za-z0-9][A-Za-z0-9._-]{0,99}$"},
        "tag": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
        "descriptor_asset_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,122}\\.json$"}
      }
    },
    "public_signature_envelope": {
      "description": "Public Ed25519 signature envelope. Key material remains in the code-signed installer trust configuration; the signature is 64 raw bytes encoded as canonical unpadded base64url.",
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "signature"],
      "properties": {
        "algorithm": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
        "signature": {"type": "string", "pattern": "^[A-Za-z0-9_-]{86}$"}
      }
    },
    "catalog_feed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": {"$ref": "#/$defs/https_url"}
      }
    },
    "installer_asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operating_system", "architecture", "minimum_macos_version", "asset_name", "digest", "bundle_identifier", "team_identifier", "code_directory_sha256", "notarization_receipt_reference"],
      "properties": {
        "operating_system": {"const": "macos"},
        "architecture": {"const": "arm64"},
        "minimum_macos_version": {"const": "26.0.0"},
        "asset_name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,123}\\.zip$"},
        "digest": {"$ref": "#/$defs/sha256"},
        "bundle_identifier": {"type": "string", "pattern": "^[A-Za-z0-9-]+(?:\\.[A-Za-z0-9-]+)+$"},
        "team_identifier": {"type": "string", "pattern": "^[A-Z0-9]{10}$"},
        "code_directory_sha256": {"$ref": "#/$defs/raw_sha256"},
        "notarization_receipt_reference": {"type": "string", "pattern": "^receipt:[a-z0-9][a-z0-9._-]{0,127}$"}
      }
    }
  }
}
