{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/autonomous-engineering-system/forge-platform/schemas/universal-installer-release-provenance.schema.json",
  "title": "Forge Platform installer release provenance",
  "description": "Public, code-signed provenance packaged inside one released macOS installer. It intentionally excludes URLs, credentials, keys, final archive bytes, and a final descriptor digest so release signing does not create a circular dependency.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provenance_sha256",
    "installer_version",
    "channel",
    "release_sequence",
    "source_revision",
    "policy_revision",
    "capabilities",
    "release_trust_configuration_sha256"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "provenance_sha256": {"$ref": "#/$defs/raw_sha256"},
    "installer_version": {"$ref": "#/$defs/semver"},
    "channel": {"enum": ["stable", "candidate"]},
    "release_sequence": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"},
    "policy_revision": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._/-]{0,127}$"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"},
      "description": "The producer serializes these in strictly ascending lexical order; runtime parsers enforce that order before recomputing provenance_sha256."
    },
    "release_trust_configuration_sha256": {"$ref": "#/$defs/raw_sha256"}
  },
  "$defs": {
    "raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "semver": {"type": "string", "maxLength": 59, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$", "description": "Each component must also fit the native signed 64-bit InstallerVersion representation; runtime parsers enforce that numeric bound."},
    "capability": {"type": "string", "pattern": "^[a-z0-9][a-z0-9./_-]{0,127}$"}
  }
}
